# ICONCRETE — example environment file. Copy to .env and adjust.
# NEVER commit a real .env, real credentials or real company data.

# ---- Web API server (Bun) ----
# Port the Bun API server listens on. Vite proxies /api to this port.
API_PORT=3001

# ---- Database credentials (never committed) ----
# Set the application role password locally with:
#   ICONCRETE_APP_PASSWORD="$(openssl rand -base64 24)" bun run db:role
# No migration file contains a password literal.
# ICONCRETE_APP_PASSWORD=
# "production" forbids demo storage mode, rejects placeholder connection secrets and
# requires a non-demo ICONCRETE_DEMO_ADMIN_PASSWORD (12+ chars).
ICONCRETE_ENV=development

# ---- Storage mode (Phase 2 / M1) ----
# demo     = seeded in-memory adapter, no database required (default)
# test     = empty in-memory adapter for tests
# postgres = durable PostgreSQL; the server REFUSES to start if it cannot connect
#            and never falls back to memory.
ICONCRETE_STORAGE_MODE=demo
# DATABASE_URL=postgres://iconcrete_app@127.0.0.1:5432/iconcrete
# DATABASE_ADMIN_URL=postgres://postgres@127.0.0.1:5432/iconcrete
# Development only: database reset is refused unless this is 1.
# ICONCRETE_ALLOW_DESTRUCTIVE=0

# ---- Demo authentication ----
# Demo-only credential for the in-memory adapter. In postgres mode, credentials come
# from the users table instead (seeded with argon2id hashes).
# Production REJECTS this variable when it is missing, equal to Demo@2026, or shorter
# than 12 characters: the demo credential can never become a production credential.
# Set the real value through the deployment secret store; never commit it.
ICONCRETE_DEMO_ADMIN_PASSWORD=Demo@2026
ICONCRETE_SESSION_IDLE_MINUTES=30
ICONCRETE_MAX_FAILED_LOGINS=5
ICONCRETE_LOCKOUT_MINUTES=15

# ---- Excel Integration Center ----
ICONCRETE_MAX_UPLOAD_BYTES=2097152

# ---- Future integrations (placeholders, NOT active in Phase 1) ----
# DATABASE_URL=postgres://user:password@localhost:5432/iconcrete
# WHATSAPP_PROVIDER_TOKEN=
# SMTP_URL=
# BILLING_PROVIDER_KEY=
# GPS_PROVIDER_KEY=
