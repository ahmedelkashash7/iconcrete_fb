{
  "name": "iconcrete-fp",
  "version": "0.1.0",
  "description": "ICONCRETE — Ready-Mix Concrete Management (Phase 1: AUTH, Dashboard, Reports, Excel Integration Center)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:web": "vite",
    "api": "bun run server/index.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:db": "bun test tests/m1/postgres.integration.test.ts",
    "db:migrate": "bun run scripts/db.ts migrate",
    "db:seed": "bun run scripts/db.ts seed",
    "db:reset": "bun run scripts/db.ts reset",
    "db:status": "bun run scripts/db.ts status",
    "db:role": "bun run scripts/db.ts role",
    "test:excel": "python3 -m pytest excel_generator/tests -q",
    "excel": "python3 excel_generator/generate_workbook.py"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "i18next": "^26.5.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
